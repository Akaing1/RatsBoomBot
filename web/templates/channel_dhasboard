<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Your Channel | RatsBoomBot</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='/css/style.css') }}?v=2"
    >
</head>

<body class="login-page">
    <main class="login-card">
        <div class="brand login-brand">
            <div class="brand-mark">R</div>

            <div>
                <h1>RatsBoomBot</h1>
                <p>Channel Dashboard</p>
            </div>
        </div>

        <p class="eyebrow">Connected channel</p>

        <h2>{{ display_name }}</h2>

        <p class="page-description">
            Your Twitch channel is connected to RatsBoomBot.
        </p>

        <div class="channel-user-details">
            <div>
                <span>Twitch login</span>
                <strong>{{ login }}</strong>
            </div>

            <div>
                <span>Twitch user ID</span>
                <strong>{{ user_id }}</strong>
            </div>
        </div>

        <form method="post" action="/channel/logout">
            <button class="button secondary" type="submit">
                Sign Out
            </button>
        </form>
    </main>
</body>
</html>
