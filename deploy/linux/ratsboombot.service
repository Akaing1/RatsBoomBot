[Unit]
Description=RatsBoomBot Twitch Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ratsbot
Group=ratsbot
WorkingDirectory=/opt/ratsboombot
EnvironmentFile=/opt/ratsboombot/.env
ExecStart=/opt/ratsboombot/.venv/bin/python /opt/ratsboombot/main.py --runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
