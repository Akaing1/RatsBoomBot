# RatsBoomBot UAT only. Do not copy production credentials or databases here.

# Twitch UAT application credentials
CLIENT_ID=
CLIENT_SECRET=

# Test identities: akaing1 bot and developer_ninjakaing broadcaster
BOT_ID=
OWNER_ID=

PREFIX=!
DATABASE_PATH=.data/tokens.db
LEAGUE_DATABASE_PATH=.data/league.db
STREAM_LOGS_PATH=.data/logs
IGNORED_USERS=akaing1,ratsboombot

# UAT dashboard
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4346
TWITCH_ADAPTER_PORT=4344
ADMIN_BASE_URL=https://uat.ratsboombot.com
PUBLIC_BASE_URL=https://uat.ratsboombot.com
DASHBOARD_BASE_URL=https://uat.ratsboombot.com

# Use a UAT-only secret. Keep cookies host-only to prevent production session crossover.
SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
CHANNEL_SESSION_MAX_AGE_SECONDS=2592000
SESSION_COOKIE_DOMAIN=

ENVIRONMENT=uat
SESSION_HTTPS_ONLY=true
TRUST_PROXY_HEADERS=true

# Register these exact callbacks in the UAT Twitch application.
BOT_REDIRECT_URI=https://uat.ratsboombot.com/admin/oauth/bot
CHANNEL_REDIRECT_URI=https://uat.ratsboombot.com/admin/oauth/channel
PUBLIC_CHANNEL_REDIRECT_URI=https://uat.ratsboombot.com/oauth/channel/connect

BOT_SCOPES=
CHANNEL_SCOPES=

SERYBOT_USER_ID=402337290
BOT_DETECTION_MODE=learning
LOG_LEVEL=INFO
